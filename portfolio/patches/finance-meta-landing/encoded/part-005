+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+const read = (path) => readFile(new URL(`../${path}`, import.meta.url), "utf8");
+
+test("React mounts into the public root and imports the real stylesheet", async () => {
+  const [html, main] = await Promise.all([read("index.html"), read("src/main.tsx")]);
+
+  assert.match(html, /<div id="root"><\/div>/);
+  assert.match(main, /createRoot\(rootElement\)\.render/);
+  assert.match(main, /import "\.\/index\.css"/);
+  assert.doesNotMatch(html, /href="\/index\.css"/);
+});
+
+test("the public experience is branded and exposes a working contact path", async () => {
+  const [html, main] = await Promise.all([read("index.html"), read("src/main.tsx")]);
+
+  assert.match(html, /FinanceMeta/);
+  assert.match(main, /Learn finance\. Build proof\. Lead what comes next\./);
+  assert.match(main, /mailto:financeforalledu@gmail\.com/);
+  assert.match(main, /Skip to main content/);
+});
+
+test("the runtime no longer includes the particle dependency stack", async () => {
+  const [pkg, main] = await Promise.all([read("package.json"), read("src/main.tsx")]);
+
+  assert.doesNotMatch(pkg, /tsparticles|framer-motion/);
+  assert.doesNotMatch(main, /Particles|motion\./);
+});

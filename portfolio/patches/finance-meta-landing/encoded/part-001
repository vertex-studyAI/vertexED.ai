+import assert from "node:assert/strict";
+import { readdir, readFile, stat } from "node:fs/promises";
+
+const index = await readFile(new URL("../dist/index.html", import.meta.url), "utf8");
+assert.match(index, /FinanceMeta/);
+
+const assetsDirectory = new URL("../dist/assets/", import.meta.url);
+const assets = await readdir(assetsDirectory);
+
+const cssAssets = assets.filter((name) => name.endsWith(".css"));
+const javascriptAssets = assets.filter((name) => name.endsWith(".js"));
+
+assert.ok(cssAssets.length > 0, "production build must emit CSS");
+assert.ok(javascriptAssets.length > 0, "production build must emit JavaScript");
+
+for (const asset of [...cssAssets, ...javascriptAssets]) {
+  const details = await stat(new URL(asset, assetsDirectory));
+  assert.ok(details.size > 0, `${asset} must not be empty`);
+}
+
+console.log(
+  `Validated FinanceMeta production output: ${cssAssets.length} CSS and ${javascriptAssets.length} JavaScript asset(s).`,
+);

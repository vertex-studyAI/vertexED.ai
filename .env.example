# =============================================================================
# VertexED.ai — Environment Variables
# Copy this file to `.env.local` for local development.
# Set the same values in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required for auth + waitlist)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
# Preferred public key; VITE_SUPABASE_ANON_KEY remains supported for existing deployments.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by /api/waitlist + JWT verification (never expose service role in client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Modern server secret key alternative. Set one actual service credential only.
# SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI provider for Apex /api/ask
# OpenAI remains the production-safe default. Set CHATBOT_PROVIDER=nvidia only in
# an intentional benchmark/preview environment until side-by-side evidence exists.
# -----------------------------------------------------------------------------
CHATBOT_PROVIDER=openai

# OpenAI (required by default for Apex and other OpenAI-backed AI features)
OPENAI_API_KEY=sk-...
# Optional project and organization routing for members of more than one OpenAI project.
# Keep these server-side. Leave either value unset when the API key is already project-scoped.
# OPENAI_PROJECT_ID=proj_...
# OPENAI_ORGANIZATION_ID=org_...
# Legacy key alias. Prefer OPENAI_API_KEY and do not configure both.
# ChatbotKey=sk-...

# Optional OpenAI overrides for Apex. These defaults follow the current OpenAI
# balance/cost recommendations; pin evaluated snapshots before a production rollout.
CHATBOT_MODEL=gpt-5.6-terra
CHATBOT_FALLBACK_MODEL=gpt-5.6-luna

# Optional role-specific Apex model routing. Keep these unset until each model
# has passed the VertexED eval set. The browser sends only a mode; model IDs and
# provider credentials remain server-side.
# CHATBOT_FAST_MODEL=<exact-model-id>
# CHATBOT_FAST_FALLBACK_MODEL=<optional-exact-model-id>
# CHATBOT_TUTOR_MODEL=<exact-model-id>
# CHATBOT_TUTOR_FALLBACK_MODEL=<optional-exact-model-id>
# CHATBOT_REASONING_MODEL=<exact-model-id>
# CHATBOT_REASONING_FALLBACK_MODEL=<optional-exact-model-id>

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
# VertexED sends OpenAI text generation through the Responses API with store=false,
# a one-way hashed learner safety identifier, and strict JSON schemas where supported.
# Optional Answer Reviewer-specific overrides. When unset, structured review
# falls back to OPENAI_MODEL and image transcription keeps its current default.
# OPENAI_REVIEW_MODEL=<exact-model-id>
# OPENAI_REVIEW_VISION_MODEL=<vision-capable-model-id>

# NVIDIA NIM / OpenAI-compatible candidate (Apex only; opt-in)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_CHATBOT_MODEL=<exact-model-id>
# NVIDIA_CHATBOT_FALLBACK_MODEL=<optional-exact-model-id>
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# Google Gemini (optional preferred provider for Study Planner and guide chat;
# both fall back to the configured OpenAI provider when this is absent)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Browser API overrides are constrained to the current origin. Prefer a relative
# path so Preview, local development, and Production each call their own backend.
# VITE_CHATBOT_API_URL=/api/ask

# Optional: salt for waitlist IP rate-limit hashing (required in production)
WAITLIST_RATE_LIMIT_SALT=random-string

# Server-side JWT verification accepts the publishable key or legacy anon key.
# These are public keys, never service-role/secret keys.
# SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated admin emails for /admin/waitlist (server-only)
ADMIN_EMAILS=you@example.com

# Server-only bearer credential for team-invite eligibility (never expose to client).
# Generate a fresh high-entropy value per environment, e.g. `openssl rand -hex 24`.
# Do NOT copy a value from source control into production; rotate immediately if one was ever committed.
SIGNUP_INVITE_CODE=replace-with-at-least-24-random-characters

# Waitlist approval emails (Resend — optional but recommended in production)
RESEND_API_KEY=re_...
RESEND_FROM=VertexED <onboarding@vertexed.app>

# Public site URL for invite links and approval emails
APP_URL=https://www.vertexed.app
# SITE_URL=https://www.vertexed.app

# Client-side fallback for admin nav gating only (server enforces ADMIN_EMAILS)
# VITE_ADMIN_EMAILS=you@example.com

# -----------------------------------------------------------------------------
# Database: apply the complete ordered migration ledger; never paste selected
# files into SQL Editor. See README.md and docs/PRODUCTION_LAUNCH.md.
# Private beta also requires direct Auth signups to be disabled in the target
# Supabase project's Authentication settings.
# -----------------------------------------------------------------------------
# Optional public Desmos embed key, issued for your app at desmos.com/my-api.
# Without it the standard 2D/3D iframe remains available.
VITE_DESMOS_API_KEY=
